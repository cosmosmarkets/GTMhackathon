# Supabase — Project Settings → API
# Copy this file to .env.local and fill in your project's values.
# These are PUBLIC (browser) keys. RLS keeps the table safe:
#   - anon may only INSERT into `submissions`
#   - anon may only SELECT from the limited `voice_wall` view
# Run supabase-schema.sql in the Supabase SQL editor before submitting.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
